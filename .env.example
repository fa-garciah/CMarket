# ==============================
# App / Auth (NextAuth v5)
# ==============================
# Usa una URL publica o localhost segun entorno.
AUTH_URL=http://localhost:3000
# Alternativa legacy compatible con este proyecto.
NEXTAUTH_URL=http://localhost:3000

# Genera un secreto seguro, por ejemplo:
# openssl rand -base64 32
AUTH_SECRET=replace_with_strong_random_secret
# Opcional legacy
NEXTAUTH_SECRET=replace_with_strong_random_secret

# ==============================
# Database (Prisma)
# ==============================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cmarket?schema=public

# Opcional: usadas por integraciones externas / secrets.ts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmarket
DB_USER=postgres
# Si usas secrets.ts con decodificacion base64
DB_PASSWORD=replace_with_base64_password

# ==============================
# Email (Resend)
# ==============================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Opcional fallback para construir links de verificacion
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================
# Cloudinary (uploads)
# ==============================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================
# Sentry (opcional)
# ==============================
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ==============================
# Deploy / webhooks (opcional)
# ==============================
DOKPLOY_WEBHOOK_URL=https://example.com/webhook

# ==============================
# Docker build secret (solo si construyes la imagen)
# ==============================
BELLA_BAXTER_API_KEY=your_bella_baxter_api_key
